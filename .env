# Copy this file to ".env" and fill in your real password.

DB_HOST=localhost
DB_PORT=5432                    # <- Fill Actual server port from pg admin4 app (default is as it is)
DB_NAME=steel_pipe_db           # <- Fill Actual Server Name from pg admin4 app
DB_USER=postgres
DB_PASSWORD=POSTGRESQLPASSWORD  # <- Fill Actual Password from postgresql account 
